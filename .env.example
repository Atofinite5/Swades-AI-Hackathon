# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5433/my-better-t-app

# ─── Server ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Transcription (Groq Whisper) ─────────────────────────────────────────────
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model options (all free on Groq):
#   whisper-large-v3-turbo   ← default: best speed/accuracy balance
#   whisper-large-v3         ← highest accuracy, slightly slower
WHISPER_MODEL=whisper-large-v3

# ─── Storage (MinIO — local S3-compatible bucket) ──────────────────────────────
# Start with: npm run db:start (docker compose includes MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=audio-chunks
