{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "mkdir -p dist && bun build ./src/index.ts --outdir ./dist --entry-naming \"[name].mjs\" --target node --format esm --sourcemap",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@hono/node-server": "^1.19.12",
    "@my-better-t-app/db": "*",
    "@my-better-t-app/env": "*",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@my-better-t-app/config": "*",
    "@types/bun": "^1.3.4",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  }
}
